generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
  previewFeatures     = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis, pg_trgm, citext]
}

// ─── Identity and access (Phase 2) ──────────────────────────────────────────────

/// PRD §4.1 account states. PENDING_VERIFICATION accounts can sign in but cannot submit
/// reports, comment or join organizations until the email address is verified.
enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
  DELETED
}

/// Platform-wide role. Organization roles are separate (OrganizationMember.role).
enum PlatformRole {
  CITIZEN
  SUPER_ADMIN
}

enum PreferredLocale {
  en
  bn
}

model User {
  id                String          @id @default(uuid(7)) @db.Uuid
  email             String          @unique @db.Citext
  name              String          @db.VarChar(100)
  passwordHash      String          @map("password_hash")
  status            AccountStatus   @default(PENDING_VERIFICATION)
  platformRole      PlatformRole    @default(CITIZEN) @map("platform_role")
  preferredLocale   PreferredLocale @default(en) @map("preferred_locale")
  emailVerifiedAt   DateTime?       @map("email_verified_at") @db.Timestamptz(3)
  passwordChangedAt DateTime        @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions                UserSession[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  mfa                     UserMfa?
  mfaBackupCodes          MfaBackupCode[]
  memberships             OrganizationMember[]             @relation("MemberUser")
  invitedMemberships      OrganizationMember[]             @relation("MemberInvitedBy")
  auditLogs               AuditLog[]
  organizationsCreated    Organization[]                   @relation("OrganizationCreatedBy")
  verificationDecisions   OrganizationVerificationRecord[] @relation("VerificationDecidedBy")
  invitationsSent         OrganizationInvitation[]         @relation("InvitationInvitedBy")
  invitationsAccepted     OrganizationInvitation[]         @relation("InvitationAcceptedBy")
  serviceAreasCreated     ServiceArea[]                    @relation("ServiceAreaCreatedBy")

  @@map("users")
}

/// Metadata for listing and revoking sessions. The live session is stored in Redis under a
/// hash of the cookie value; the raw session token is never persisted.
model UserSession {
  id                String    @id @default(uuid(7)) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.Char(64)
  ipAddress         String?   @map("ip_address") @db.VarChar(45)
  userAgent         String?   @map("user_agent") @db.VarChar(255)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason     String?   @map("revoked_reason") @db.VarChar(50)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@map("user_sessions")
}

/// Single-use email verification tokens. Only a SHA-256 hash of the token is stored.
model EmailVerificationToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("email_verification_tokens")
}

/// Single-use password reset tokens. Only a SHA-256 hash of the token is stored.
model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// TOTP two-factor configuration. The secret is encrypted with AES-256-GCM (MFA_ENCRYPTION_KEY).
model UserMfa {
  userId          String    @id @map("user_id") @db.Uuid
  secretEncrypted String    @map("secret_encrypted")
  enabledAt       DateTime? @map("enabled_at") @db.Timestamptz(3)
  /// Last accepted TOTP time step; codes at or before it are rejected (replay protection).
  lastUsedStep    BigInt?   @map("last_used_step")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("user_mfa")
}

/// One-time backup codes for two-factor login. Only SHA-256 hashes are stored.
model MfaBackupCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash") @db.Char(64)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("mfa_backup_codes")
}

// ─── Organizations (membership foundation; full model in Phase 3) ───────────────

enum OrganizationVerificationState {
  UNVERIFIED
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  SUSPENDED
}

/// Organization-specific roles (approved): admins manage the organization, reviewers review
/// reports and verify completed work, workers carry out assigned tasks.
enum OrganizationRole {
  ORG_ADMIN
  ORG_REVIEWER
  WORKER
}

/// Initial organization types (approved: city corporations only at launch).
enum OrganizationType {
  CITY_CORPORATION
}

enum MembershipStatus {
  INVITED
  ACTIVE
  REMOVED
}

model Organization {
  id                  String                        @id @default(uuid(7)) @db.Uuid
  name                String                        @unique @db.Citext
  type                OrganizationType              @default(CITY_CORPORATION)
  description         String?                       @db.VarChar(2000)
  website             String?                       @db.VarChar(300)
  /// Public contact details shown on the organization's public profile.
  publicEmail         String?                       @map("public_email") @db.VarChar(254)
  publicPhone         String?                       @map("public_phone") @db.VarChar(30)
  /// Government email domain the verification contact must use (e.g. "dncc.gov.bd").
  officialEmailDomain String                        @map("official_email_domain") @db.VarChar(253)
  verificationState   OrganizationVerificationState @default(UNVERIFIED) @map("verification_state")
  isActive            Boolean                       @default(true) @map("is_active")
  createdById         String?                       @map("created_by_id") @db.Uuid
  createdAt           DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy           User?                            @relation("OrganizationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  members             OrganizationMember[]
  verificationContact OrganizationVerificationContact?
  verificationRecords OrganizationVerificationRecord[]
  invitations         OrganizationInvitation[]
  serviceAreas        ServiceArea[]
  categories          OrganizationCategory[]

  @@index([verificationState, isActive])
  @@map("organizations")
}

/// The named person at the organization who confirms control of the official email domain by
/// following a single-use link sent to their official address.
model OrganizationVerificationContact {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @unique @map("organization_id") @db.Uuid
  name           String    @db.VarChar(100)
  jobTitle       String    @map("job_title") @db.VarChar(100)
  email          String    @db.Citext
  tokenHash      String?   @unique @map("token_hash") @db.Char(64)
  tokenExpiresAt DateTime? @map("token_expires_at") @db.Timestamptz(3)
  confirmedAt    DateTime? @map("confirmed_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@map("organization_verification_contacts")
}

/// Append-only history of verification decisions (PRD §7.2). A trigger rejects UPDATE/DELETE.
model OrganizationVerificationRecord {
  id             String                        @id @default(uuid(7)) @db.Uuid
  organizationId String                        @map("organization_id") @db.Uuid
  fromState      OrganizationVerificationState @map("from_state")
  toState        OrganizationVerificationState @map("to_state")
  decidedById    String                        @map("decided_by_id") @db.Uuid
  reason         String?                       @db.VarChar(1000)
  createdAt      DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  decidedBy    User         @relation("VerificationDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@map("organization_verification_records")
}

/// Single-use invitations to join an organization. Only a SHA-256 hash of the token is stored.
model OrganizationInvitation {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  email          String           @db.Citext
  role           OrganizationRole
  tokenHash      String           @unique @map("token_hash") @db.Char(64)
  expiresAt      DateTime         @map("expires_at") @db.Timestamptz(3)
  invitedById    String           @map("invited_by_id") @db.Uuid
  acceptedAt     DateTime?        @map("accepted_at") @db.Timestamptz(3)
  acceptedById   String?          @map("accepted_by_id") @db.Uuid
  revokedAt      DateTime?        @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invitedBy    User         @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedBy   User?        @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: Restrict)

  @@index([organizationId, acceptedAt, revokedAt])
  @@index([email])
  @@map("organization_invitations")
}

/// Area an organization serves, as a WGS84 (EPSG:4326) MultiPolygon. Written and queried with
/// raw SQL because Prisma does not support PostGIS types (see ServiceAreasService).
model ServiceArea {
  id             String                                     @id @default(uuid(7)) @db.Uuid
  organizationId String                                     @map("organization_id") @db.Uuid
  name           String                                     @db.VarChar(200)
  geom           Unsupported("geometry(MultiPolygon,4326)")
  areaSqKm       Decimal                                    @map("area_sq_km") @db.Decimal(12, 3)
  pointCount     Int                                        @map("point_count")
  isActive       Boolean                                    @default(true) @map("is_active")
  createdById    String                                     @map("created_by_id") @db.Uuid
  createdAt      DateTime                                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("ServiceAreaCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([geom], type: Gist)
  @@index([organizationId, isActive])
  @@map("service_areas")
}

/// Global, administrable issue categories (PRD §5.3). At most two levels deep.
model ReportCategory {
  id               String   @id @default(uuid(7)) @db.Uuid
  slug             String   @unique @db.VarChar(60)
  parentId         String?  @map("parent_id") @db.Uuid
  nameEn           String   @map("name_en") @db.VarChar(100)
  nameBn           String   @map("name_bn") @db.VarChar(100)
  descriptionEn    String?  @map("description_en") @db.VarChar(500)
  descriptionBn    String?  @map("description_bn") @db.VarChar(500)
  isActive         Boolean  @default(true) @map("is_active")
  displayOrder     Int      @default(0) @map("display_order")
  /// Radius for duplicate candidate search (Phase 8). Unset until validated with real data.
  duplicateRadiusM Int?     @map("duplicate_radius_m")
  aiConfig         Json?    @map("ai_config")
  evidenceRules    Json?    @map("evidence_rules")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent        ReportCategory?        @relation("CategoryParent", fields: [parentId], references: [id], onDelete: Restrict)
  children      ReportCategory[]       @relation("CategoryParent")
  organizations OrganizationCategory[]

  @@index([parentId, displayOrder])
  @@map("report_categories")
}

/// Categories an organization handles.
model OrganizationCategory {
  organizationId String   @map("organization_id") @db.Uuid
  categoryId     String   @map("category_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category     ReportCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([organizationId, categoryId])
  @@index([categoryId])
  @@map("organization_categories")
}

model OrganizationMember {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole
  status         MembershipStatus @default(INVITED)
  invitedById    String?          @map("invited_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  approvedAt     DateTime?        @map("approved_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation("MemberUser", fields: [userId], references: [id], onDelete: Restrict)
  invitedBy    User?        @relation("MemberInvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@map("organization_members")
}

// ─── Audit ─────────────────────────────────────────────────────────────────────

enum AuditResult {
  SUCCESS
  FAILURE
}

/// Insert-only record of security-relevant actions (PRD §26.7). A database trigger rejects
/// UPDATE and DELETE. Never store passwords, tokens or other secrets in metadata.
model AuditLog {
  id          String      @id @default(uuid(7)) @db.Uuid
  actorUserId String?     @map("actor_user_id") @db.Uuid
  action      String      @db.VarChar(100)
  targetType  String?     @map("target_type") @db.VarChar(50)
  targetId    String?     @map("target_id") @db.VarChar(100)
  result      AuditResult
  reason      String?     @db.VarChar(1000)
  requestId   String?     @map("request_id") @db.VarChar(64)
  ipAddress   String?     @map("ip_address") @db.VarChar(45)
  metadata    Json?
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}
