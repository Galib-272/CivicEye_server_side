generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
  previewFeatures     = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis, pg_trgm, citext]
}

// ─── Identity and access (Phase 2) ──────────────────────────────────────────────

/// PRD §4.1 account states. PENDING_VERIFICATION accounts can sign in but cannot submit
/// reports, comment or join organizations until the email address is verified.
enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
  DELETED
}

/// Platform-wide role. Organization roles are separate (OrganizationMember.role).
enum PlatformRole {
  CITIZEN
  SUPER_ADMIN
}

enum PreferredLocale {
  en
  bn
}

model User {
  id                String          @id @default(uuid(7)) @db.Uuid
  email             String          @unique @db.Citext
  name              String          @db.VarChar(100)
  passwordHash      String          @map("password_hash")
  status            AccountStatus   @default(PENDING_VERIFICATION)
  platformRole      PlatformRole    @default(CITIZEN) @map("platform_role")
  preferredLocale   PreferredLocale @default(en) @map("preferred_locale")
  emailVerifiedAt   DateTime?       @map("email_verified_at") @db.Timestamptz(3)
  passwordChangedAt DateTime        @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions                UserSession[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  mfa                     UserMfa?
  mfaBackupCodes          MfaBackupCode[]
  memberships             OrganizationMember[]             @relation("MemberUser")
  invitedMemberships      OrganizationMember[]             @relation("MemberInvitedBy")
  auditLogs               AuditLog[]
  organizationsCreated    Organization[]                   @relation("OrganizationCreatedBy")
  verificationDecisions   OrganizationVerificationRecord[] @relation("VerificationDecidedBy")
  invitationsSent         OrganizationInvitation[]         @relation("InvitationInvitedBy")
  invitationsAccepted     OrganizationInvitation[]         @relation("InvitationAcceptedBy")
  serviceAreasCreated     ServiceArea[]                    @relation("ServiceAreaCreatedBy")
  reports                 Report[]                         @relation("ReportCitizen")
  statusChanges           ReportStatusHistory[]            @relation("StatusHistoryActor")
  reportEdits             ReportEdit[]                     @relation("ReportEditor")
  mediaUploads            ReportMedia[]                    @relation("MediaUploader")
  routingDecisions        ReportRoutingDecision[]          @relation("RoutingDecidedBy")
  reviewDecisions         ReportReviewDecision[]           @relation("ReviewDecisionReviewer")
  informationRequests     ReportInformationRequest[]       @relation("InformationRequester")
  informationResponses    ReportInformationResponse[]      @relation("InformationResponder")
  reportTransfers         ReportTransfer[]                 @relation("TransferActor")
  internalNotes           ReportInternalNote[]             @relation("InternalNoteAuthor")
  publicUpdates           ReportPublicUpdate[]             @relation("PublicUpdateAuthor")
  hiddenPublicUpdates     ReportPublicUpdate[]             @relation("PublicUpdateHiddenBy")
  workAssignments         ReportAssignment[]               @relation("AssignmentWorker")
  assignmentsMade         ReportAssignment[]               @relation("AssignmentAssigner")
  assignmentEvents        AssignmentEvent[]                @relation("AssignmentEventActor")
  completionSubmissions   CompletionSubmission[]           @relation("CompletionWorker")
  verifications           WorkVerification[]               @relation("WorkVerifier")
  reportFeedback          CitizenFeedback[]                @relation("FeedbackCitizen")
  idempotencyKeys         IdempotencyKey[]                 @relation("IdempotencyKeyUser")

  @@map("users")
}

/// Metadata for listing and revoking sessions. The live session is stored in Redis under a
/// hash of the cookie value; the raw session token is never persisted.
model UserSession {
  id                String    @id @default(uuid(7)) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.Char(64)
  ipAddress         String?   @map("ip_address") @db.VarChar(45)
  userAgent         String?   @map("user_agent") @db.VarChar(255)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason     String?   @map("revoked_reason") @db.VarChar(50)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@map("user_sessions")
}

/// Single-use email verification tokens. Only a SHA-256 hash of the token is stored.
model EmailVerificationToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("email_verification_tokens")
}

/// Single-use password reset tokens. Only a SHA-256 hash of the token is stored.
model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// TOTP two-factor configuration. The secret is encrypted with AES-256-GCM (MFA_ENCRYPTION_KEY).
model UserMfa {
  userId          String    @id @map("user_id") @db.Uuid
  secretEncrypted String    @map("secret_encrypted")
  enabledAt       DateTime? @map("enabled_at") @db.Timestamptz(3)
  /// Last accepted TOTP time step; codes at or before it are rejected (replay protection).
  lastUsedStep    BigInt?   @map("last_used_step")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("user_mfa")
}

/// One-time backup codes for two-factor login. Only SHA-256 hashes are stored.
model MfaBackupCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash") @db.Char(64)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("mfa_backup_codes")
}

// ─── Organizations (membership foundation; full model in Phase 3) ───────────────

enum OrganizationVerificationState {
  UNVERIFIED
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  SUSPENDED
}

/// Organization-specific roles (approved): admins manage the organization, reviewers review
/// reports and verify completed work, workers carry out assigned tasks.
enum OrganizationRole {
  ORG_ADMIN
  ORG_REVIEWER
  WORKER
}

/// Initial organization types (approved: city corporations only at launch).
enum OrganizationType {
  CITY_CORPORATION
}

enum MembershipStatus {
  INVITED
  ACTIVE
  REMOVED
}

model Organization {
  id                  String                        @id @default(uuid(7)) @db.Uuid
  name                String                        @unique @db.Citext
  type                OrganizationType              @default(CITY_CORPORATION)
  description         String?                       @db.VarChar(2000)
  website             String?                       @db.VarChar(300)
  /// Public contact details shown on the organization's public profile.
  publicEmail         String?                       @map("public_email") @db.VarChar(254)
  publicPhone         String?                       @map("public_phone") @db.VarChar(30)
  /// Government email domain the verification contact must use (e.g. "dncc.gov.bd").
  officialEmailDomain String                        @map("official_email_domain") @db.VarChar(253)
  verificationState   OrganizationVerificationState @default(UNVERIFIED) @map("verification_state")
  isActive            Boolean                       @default(true) @map("is_active")
  createdById         String?                       @map("created_by_id") @db.Uuid
  createdAt           DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy           User?                            @relation("OrganizationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  members             OrganizationMember[]
  verificationContact OrganizationVerificationContact?
  verificationRecords OrganizationVerificationRecord[]
  invitations         OrganizationInvitation[]
  serviceAreas        ServiceArea[]
  categories          OrganizationCategory[]
  reports             Report[]
  routingDecisions    ReportRoutingDecision[]          @relation("RoutingDecisionOrganization")
  reviewDecisions     ReportReviewDecision[]
  informationRequests ReportInformationRequest[]
  transfersOut        ReportTransfer[]                 @relation("TransferFrom")
  transfersIn         ReportTransfer[]                 @relation("TransferTo")
  internalNotes       ReportInternalNote[]
  publicUpdates       ReportPublicUpdate[]
  assignments         ReportAssignment[]

  @@index([verificationState, isActive])
  @@map("organizations")
}

/// The named person at the organization who confirms control of the official email domain by
/// following a single-use link sent to their official address.
model OrganizationVerificationContact {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @unique @map("organization_id") @db.Uuid
  name           String    @db.VarChar(100)
  jobTitle       String    @map("job_title") @db.VarChar(100)
  email          String    @db.Citext
  tokenHash      String?   @unique @map("token_hash") @db.Char(64)
  tokenExpiresAt DateTime? @map("token_expires_at") @db.Timestamptz(3)
  confirmedAt    DateTime? @map("confirmed_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@map("organization_verification_contacts")
}

/// Append-only history of verification decisions (PRD §7.2). A trigger rejects UPDATE/DELETE.
model OrganizationVerificationRecord {
  id             String                        @id @default(uuid(7)) @db.Uuid
  organizationId String                        @map("organization_id") @db.Uuid
  fromState      OrganizationVerificationState @map("from_state")
  toState        OrganizationVerificationState @map("to_state")
  decidedById    String                        @map("decided_by_id") @db.Uuid
  reason         String?                       @db.VarChar(1000)
  createdAt      DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  decidedBy    User         @relation("VerificationDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@map("organization_verification_records")
}

/// Single-use invitations to join an organization. Only a SHA-256 hash of the token is stored.
model OrganizationInvitation {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  email          String           @db.Citext
  role           OrganizationRole
  tokenHash      String           @unique @map("token_hash") @db.Char(64)
  expiresAt      DateTime         @map("expires_at") @db.Timestamptz(3)
  invitedById    String           @map("invited_by_id") @db.Uuid
  acceptedAt     DateTime?        @map("accepted_at") @db.Timestamptz(3)
  acceptedById   String?          @map("accepted_by_id") @db.Uuid
  revokedAt      DateTime?        @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invitedBy    User         @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedBy   User?        @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: Restrict)

  @@index([organizationId, acceptedAt, revokedAt])
  @@index([email])
  @@map("organization_invitations")
}

/// Area an organization serves, as a WGS84 (EPSG:4326) MultiPolygon. Written and queried with
/// raw SQL because Prisma does not support PostGIS types (see ServiceAreasService).
model ServiceArea {
  id             String                                     @id @default(uuid(7)) @db.Uuid
  organizationId String                                     @map("organization_id") @db.Uuid
  name           String                                     @db.VarChar(200)
  geom           Unsupported("geometry(MultiPolygon,4326)")
  areaSqKm       Decimal                                    @map("area_sq_km") @db.Decimal(12, 3)
  pointCount     Int                                        @map("point_count")
  isActive       Boolean                                    @default(true) @map("is_active")
  createdById    String                                     @map("created_by_id") @db.Uuid
  createdAt      DateTime                                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("ServiceAreaCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([geom], type: Gist)
  @@index([organizationId, isActive])
  @@map("service_areas")
}

/// Global, administrable issue categories (PRD §5.3). At most two levels deep.
model ReportCategory {
  id               String   @id @default(uuid(7)) @db.Uuid
  slug             String   @unique @db.VarChar(60)
  parentId         String?  @map("parent_id") @db.Uuid
  nameEn           String   @map("name_en") @db.VarChar(100)
  nameBn           String   @map("name_bn") @db.VarChar(100)
  descriptionEn    String?  @map("description_en") @db.VarChar(500)
  descriptionBn    String?  @map("description_bn") @db.VarChar(500)
  isActive         Boolean  @default(true) @map("is_active")
  displayOrder     Int      @default(0) @map("display_order")
  /// Radius for duplicate candidate search (Phase 8). Unset until validated with real data.
  duplicateRadiusM Int?     @map("duplicate_radius_m")
  aiConfig         Json?    @map("ai_config")
  evidenceRules    Json?    @map("evidence_rules")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent        ReportCategory?        @relation("CategoryParent", fields: [parentId], references: [id], onDelete: Restrict)
  children      ReportCategory[]       @relation("CategoryParent")
  organizations OrganizationCategory[]
  reports       Report[]
  reviewsFrom   ReportReviewDecision[] @relation("ReviewCategoryFrom")
  reviewsTo     ReportReviewDecision[] @relation("ReviewCategoryTo")

  @@index([parentId, displayOrder])
  @@map("report_categories")
}

/// Categories an organization handles.
model OrganizationCategory {
  organizationId String   @map("organization_id") @db.Uuid
  categoryId     String   @map("category_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category     ReportCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([organizationId, categoryId])
  @@index([categoryId])
  @@map("organization_categories")
}

model OrganizationMember {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole
  status         MembershipStatus @default(INVITED)
  invitedById    String?          @map("invited_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  approvedAt     DateTime?        @map("approved_at") @db.Timestamptz(3)
  /// Workers set this; unavailable workers cannot receive new assignments.
  available      Boolean          @default(true)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation("MemberUser", fields: [userId], references: [id], onDelete: Restrict)
  invitedBy    User?        @relation("MemberInvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@map("organization_members")
}

// ─── Audit ─────────────────────────────────────────────────────────────────────

enum AuditResult {
  SUCCESS
  FAILURE
}

/// Insert-only record of security-relevant actions (PRD §26.7). A database trigger rejects
/// UPDATE and DELETE. Never store passwords, tokens or other secrets in metadata.
model AuditLog {
  id          String      @id @default(uuid(7)) @db.Uuid
  actorUserId String?     @map("actor_user_id") @db.Uuid
  action      String      @db.VarChar(100)
  targetType  String?     @map("target_type") @db.VarChar(50)
  targetId    String?     @map("target_id") @db.VarChar(100)
  result      AuditResult
  reason      String?     @db.VarChar(1000)
  requestId   String?     @map("request_id") @db.VarChar(64)
  ipAddress   String?     @map("ip_address") @db.VarChar(45)
  metadata    Json?
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ─── Civic reports (Phase 4) ───────────────────────────────────────────────────

/// PRD §6.1 report lifecycle. Transitions are enforced by ReportTransitionService only.
enum ReportStatus {
  SUBMITTED
  UNDER_REVIEW
  NEEDS_INFORMATION
  ACCEPTED
  REJECTED
  ASSIGNED
  IN_PROGRESS
  WORK_COMPLETED
  PENDING_VERIFICATION
  RESOLVED
  REOPENED
  CLOSED
  WITHDRAWN
  DUPLICATE
}

enum ReportVisibility {
  PUBLIC
  PRIVATE
  ORGANIZATION_ONLY
  RESTRICTED
}

/// Outcome of matching the report location to organizations' service areas.
enum RoutingOutcome {
  ROUTED
  UNROUTED
  AMBIGUOUS
  MANUAL
  /// Moved by the previous organization to another one that covers the location.
  TRANSFERRED
}

enum ReviewDecision {
  ACCEPTED
  REJECTED
}

/// Approved rejection reasons. Each rejection also carries a message the citizen sees.
enum RejectionReason {
  NOT_A_CIVIC_ISSUE
  INSUFFICIENT_INFORMATION
  ALREADY_FIXED
  INAPPROPRIATE_CONTENT
  NO_RESPONSE
  OTHER
}

model Report {
  id                  String                               @id @default(uuid(7)) @db.Uuid
  /// Human-friendly, unguessable identifier shown to users, e.g. CE-7K3M-Q9TX.
  publicId            String                               @unique @map("public_id") @db.VarChar(16)
  citizenId           String                               @map("citizen_id") @db.Uuid
  organizationId      String?                              @map("organization_id") @db.Uuid
  categoryId          String                               @map("category_id") @db.Uuid
  title               String                               @db.VarChar(120)
  description         String                               @db.VarChar(2000)
  status              ReportStatus                         @default(SUBMITTED)
  /// Unset until the report priority policy is decided.
  priority            Int?
  /// WGS84 point. Written and queried with raw SQL (Prisma has no PostGIS types).
  location            Unsupported("geography(Point,4326)")
  /// Exact coordinates for display; the geography column is authoritative for spatial queries.
  latitude            Decimal                              @db.Decimal(9, 6)
  longitude           Decimal                              @db.Decimal(9, 6)
  locationAccuracyM   Int?                                 @map("location_accuracy_m")
  locationDescription String?                              @map("location_description") @db.VarChar(300)
  visibility          ReportVisibility                     @default(PUBLIC)
  routingOutcome      RoutingOutcome                       @map("routing_outcome")
  version             Int                                  @default(1)
  submittedAt         DateTime                             @default(now()) @map("submitted_at") @db.Timestamptz(3)
  reviewedAt          DateTime?                            @map("reviewed_at") @db.Timestamptz(3)
  resolvedAt          DateTime?                            @map("resolved_at") @db.Timestamptz(3)
  closedAt            DateTime?                            @map("closed_at") @db.Timestamptz(3)
  createdAt           DateTime                             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                             @updatedAt @map("updated_at") @db.Timestamptz(3)

  citizen          User                       @relation("ReportCitizen", fields: [citizenId], references: [id], onDelete: Restrict)
  organization     Organization?              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category         ReportCategory             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  statusHistory    ReportStatusHistory[]
  edits            ReportEdit[]
  media            ReportMedia[]
  routingDecisions ReportRoutingDecision[]
  reviewDecisions  ReportReviewDecision[]
  infoRequests     ReportInformationRequest[]
  transfers        ReportTransfer[]
  internalNotes    ReportInternalNote[]
  publicUpdates    ReportPublicUpdate[]
  assignments      ReportAssignment[]
  verifications    WorkVerification[]
  feedback         CitizenFeedback[]

  @@index([location], type: Gist)
  @@index([citizenId, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([status, visibility, createdAt])
  @@index([routingOutcome, status])
  @@index([categoryId])
  @@map("reports")
}

/// Append-only status timeline (PRD §6.4). A trigger rejects UPDATE/DELETE.
model ReportStatusHistory {
  id            String        @id @default(uuid(7)) @db.Uuid
  reportId      String        @map("report_id") @db.Uuid
  fromStatus    ReportStatus? @map("from_status")
  toStatus      ReportStatus  @map("to_status")
  actorUserId   String?       @map("actor_user_id") @db.Uuid
  /// Role or permission context of the actor, e.g. "citizen", "super_admin", "system".
  actorContext  String        @map("actor_context") @db.VarChar(50)
  reason        String?       @db.VarChar(1000)
  publicMessage String?       @map("public_message") @db.VarChar(1000)
  internalNote  String?       @map("internal_note") @db.VarChar(2000)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  report Report @relation(fields: [reportId], references: [id], onDelete: Restrict)
  actor  User?  @relation("StatusHistoryActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([reportId, createdAt])
  @@map("report_status_history")
}

/// Append-only record of every citizen edit, field by field.
model ReportEdit {
  id        String   @id @default(uuid(7)) @db.Uuid
  reportId  String   @map("report_id") @db.Uuid
  editorId  String   @map("editor_id") @db.Uuid
  version   Int
  changes   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  report Report @relation(fields: [reportId], references: [id], onDelete: Restrict)
  editor User   @relation("ReportEditor", fields: [editorId], references: [id], onDelete: Restrict)

  @@index([reportId, version])
  @@map("report_edits")
}

enum MediaStatus {
  PENDING_UPLOAD
  UPLOADED
  PROCESSED
  REJECTED
}

enum MediaPurpose {
  REPORT_PHOTO
  /// Progress and completion photos taken by the assigned worker.
  WORK_PHOTO
}

/// PENDING → ACCEPTED → IN_PROGRESS → COMPLETED (evidence submitted) → VERIFIED; or it ends
/// as DECLINED, RETURNED or CANCELLED. At most one active assignment per report.
enum AssignmentState {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  VERIFIED
  DECLINED
  RETURNED
  CANCELLED
}

enum AssignmentEventKind {
  ASSIGNED
  ACCEPTED
  DECLINED
  STARTED
  PROGRESS
  COMPLETED
  APPROVED
  REJECTED
  MORE_EVIDENCE_NEEDED
  RETURNED
  CANCELLED
}

enum VerificationOutcome {
  APPROVED
  REJECTED
  NEEDS_MORE_EVIDENCE
}

model ReportMedia {
  id              String       @id @default(uuid(7)) @db.Uuid
  reportId        String?      @map("report_id") @db.Uuid
  uploaderId      String       @map("uploader_id") @db.Uuid
  purpose         MediaPurpose
  status          MediaStatus  @default(PENDING_UPLOAD)
  /// Random, server-generated object keys; never derived from user input.
  originalKey     String       @unique @map("original_key") @db.VarChar(200)
  displayKey      String?      @map("display_key") @db.VarChar(200)
  thumbnailKey    String?      @map("thumbnail_key") @db.VarChar(200)
  declaredType    String       @map("declared_type") @db.VarChar(50)
  declaredBytes   Int          @map("declared_bytes")
  detectedFormat  String?      @map("detected_format") @db.VarChar(20)
  width           Int?
  height          Int?
  sha256          String?      @db.Char(64)
  rejectionReason String?      @map("rejection_reason") @db.VarChar(300)
  position        Int          @default(0)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  processedAt     DateTime?    @map("processed_at") @db.Timestamptz(3)

  /// Set for WORK_PHOTO media once used in a progress update or completion submission.
  assignmentId String? @map("assignment_id") @db.Uuid

  report     Report?           @relation(fields: [reportId], references: [id], onDelete: Restrict)
  uploader   User              @relation("MediaUploader", fields: [uploaderId], references: [id], onDelete: Restrict)
  assignment ReportAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Restrict)

  @@index([reportId, position])
  @@index([assignmentId])
  @@index([uploaderId, status, createdAt])
  @@map("report_media")
}

/// Explains how a report was matched to an organization (PRD §7.5).
model ReportRoutingDecision {
  id             String         @id @default(uuid(7)) @db.Uuid
  reportId       String         @map("report_id") @db.Uuid
  outcome        RoutingOutcome
  organizationId String?        @map("organization_id") @db.Uuid
  /// Organizations whose service areas covered the point at decision time.
  candidates     Json
  rule           String         @db.VarChar(100)
  decidedById    String?        @map("decided_by_id") @db.Uuid
  reason         String?        @db.VarChar(1000)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  report       Report        @relation(fields: [reportId], references: [id], onDelete: Restrict)
  organization Organization? @relation("RoutingDecisionOrganization", fields: [organizationId], references: [id], onDelete: Restrict)
  decidedBy    User?         @relation("RoutingDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([reportId, createdAt])
  @@map("report_routing_decisions")
}

/// Stored responses for Idempotency-Key requests, so a retried submission returns the original result.
model IdempotencyKey {
  id           String   @id @default(uuid(7)) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  key          String   @db.VarChar(100)
  route        String   @db.VarChar(100)
  requestHash  String   @map("request_hash") @db.Char(64)
  responseBody Json?    @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(3)

  user User @relation("IdempotencyKeyUser", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, route, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// Accept/reject decisions by an organization reviewer. Append-only.
model ReportReviewDecision {
  id              String           @id @default(uuid(7)) @db.Uuid
  reportId        String           @map("report_id") @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  reviewerId      String           @map("reviewer_id") @db.Uuid
  decision        ReviewDecision
  rejectionReason RejectionReason? @map("rejection_reason")
  /// Shown to the citizen (and publicly for public reports).
  publicMessage   String?          @map("public_message") @db.VarChar(1000)
  /// Set when the reviewer corrected the category while accepting.
  categoryFromId  String?          @map("category_from_id") @db.Uuid
  categoryToId    String?          @map("category_to_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  report       Report          @relation(fields: [reportId], references: [id], onDelete: Restrict)
  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  reviewer     User            @relation("ReviewDecisionReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  categoryFrom ReportCategory? @relation("ReviewCategoryFrom", fields: [categoryFromId], references: [id], onDelete: Restrict)
  categoryTo   ReportCategory? @relation("ReviewCategoryTo", fields: [categoryToId], references: [id], onDelete: Restrict)

  @@index([reportId, createdAt])
  @@map("report_review_decisions")
}

/// A reviewer asking the citizen for more information. Append-only.
model ReportInformationRequest {
  id             String   @id @default(uuid(7)) @db.Uuid
  reportId       String   @map("report_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  requestedById  String   @map("requested_by_id") @db.Uuid
  message        String   @db.VarChar(1000)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  report       Report                     @relation(fields: [reportId], references: [id], onDelete: Restrict)
  organization Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  requestedBy  User                       @relation("InformationRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  response     ReportInformationResponse?

  @@index([reportId, createdAt])
  @@map("report_information_requests")
}

/// The citizen's answer to one information request. Append-only, at most one per request.
model ReportInformationResponse {
  id            String   @id @default(uuid(7)) @db.Uuid
  requestId     String   @unique @map("request_id") @db.Uuid
  respondedById String   @map("responded_by_id") @db.Uuid
  message       String   @db.VarChar(2000)
  /// Photos added with this answer (also attached to the report).
  mediaIds      String[] @map("media_ids") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  request     ReportInformationRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  respondedBy User                     @relation("InformationResponder", fields: [respondedById], references: [id], onDelete: Restrict)

  @@map("report_information_responses")
}

/// Moves of a report between organizations (or back to Super Admin triage). Append-only.
model ReportTransfer {
  id                 String       @id @default(uuid(7)) @db.Uuid
  reportId           String       @map("report_id") @db.Uuid
  fromOrganizationId String       @map("from_organization_id") @db.Uuid
  /// Null when the report was sent back to Super Admin triage.
  toOrganizationId   String?      @map("to_organization_id") @db.Uuid
  actorId            String       @map("actor_id") @db.Uuid
  fromStatus         ReportStatus @map("from_status")
  reason             String       @db.VarChar(1000)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  report           Report        @relation(fields: [reportId], references: [id], onDelete: Restrict)
  fromOrganization Organization  @relation("TransferFrom", fields: [fromOrganizationId], references: [id], onDelete: Restrict)
  toOrganization   Organization? @relation("TransferTo", fields: [toOrganizationId], references: [id], onDelete: Restrict)
  actor            User          @relation("TransferActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([reportId, createdAt])
  @@map("report_transfers")
}

/// Private notes for the organization handling a report. Never returned to citizens or the
/// public, nor to other organizations after a transfer. Append-only.
model ReportInternalNote {
  id             String   @id @default(uuid(7)) @db.Uuid
  reportId       String   @map("report_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  authorId       String   @map("author_id") @db.Uuid
  body           String   @db.VarChar(2000)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  report       Report       @relation(fields: [reportId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  author       User         @relation("InternalNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([reportId, organizationId, createdAt])
  @@map("report_internal_notes")
}

/// Organization messages shown on the report page. Only the hidden_* fields may change, once,
/// when a Super Admin hides an update (enforced by a database trigger).
model ReportPublicUpdate {
  id             String    @id @default(uuid(7)) @db.Uuid
  reportId       String    @map("report_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  authorId       String    @map("author_id") @db.Uuid
  body           String    @db.VarChar(1000)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  hiddenAt       DateTime? @map("hidden_at") @db.Timestamptz(3)
  hiddenById     String?   @map("hidden_by_id") @db.Uuid
  hiddenReason   String?   @map("hidden_reason") @db.VarChar(1000)

  report       Report       @relation(fields: [reportId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  author       User         @relation("PublicUpdateAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  hiddenBy     User?        @relation("PublicUpdateHiddenBy", fields: [hiddenById], references: [id], onDelete: Restrict)

  @@index([reportId, createdAt])
  @@map("report_public_updates")
}

/// One worker's responsibility for a report. State and timestamps change as work moves on;
/// who, what and for whom never change (database trigger), and every change is recorded in
/// assignment_events.
model ReportAssignment {
  id             String          @id @default(uuid(7)) @db.Uuid
  reportId       String          @map("report_id") @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  workerId       String          @map("worker_id") @db.Uuid
  assignedById   String          @map("assigned_by_id") @db.Uuid
  state          AssignmentState @default(PENDING)
  /// Instructions from the person who assigned the task.
  note           String?         @db.VarChar(1000)
  assignedAt     DateTime        @default(now()) @map("assigned_at") @db.Timestamptz(3)
  acceptedAt     DateTime?       @map("accepted_at") @db.Timestamptz(3)
  startedAt      DateTime?       @map("started_at") @db.Timestamptz(3)
  completedAt    DateTime?       @map("completed_at") @db.Timestamptz(3)
  endedAt        DateTime?       @map("ended_at") @db.Timestamptz(3)
  endReason      String?         @map("end_reason") @db.VarChar(1000)

  report        Report                 @relation(fields: [reportId], references: [id], onDelete: Restrict)
  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  worker        User                   @relation("AssignmentWorker", fields: [workerId], references: [id], onDelete: Restrict)
  assignedBy    User                   @relation("AssignmentAssigner", fields: [assignedById], references: [id], onDelete: Restrict)
  events        AssignmentEvent[]
  submissions   CompletionSubmission[]
  verifications WorkVerification[]
  media         ReportMedia[]

  @@index([reportId, assignedAt])
  @@index([workerId, state])
  @@index([organizationId, state])
  @@map("report_assignments")
}

/// Everything that happened to an assignment, including progress notes. Append-only.
model AssignmentEvent {
  id           String              @id @default(uuid(7)) @db.Uuid
  assignmentId String              @map("assignment_id") @db.Uuid
  /// Null for system actions (e.g. the worker left the organization).
  actorId      String?             @map("actor_id") @db.Uuid
  kind         AssignmentEventKind
  message      String?             @db.VarChar(2000)
  mediaIds     String[]            @map("media_ids") @db.Uuid
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  assignment ReportAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  actor      User?            @relation("AssignmentEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([assignmentId, createdAt])
  @@map("assignment_events")
}

/// The worker's claim that the work is done, with after photos. Append-only.
model CompletionSubmission {
  id           String   @id @default(uuid(7)) @db.Uuid
  assignmentId String   @map("assignment_id") @db.Uuid
  workerId     String   @map("worker_id") @db.Uuid
  description  String   @db.VarChar(2000)
  mediaIds     String[] @map("media_ids") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  assignment   ReportAssignment  @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  worker       User              @relation("CompletionWorker", fields: [workerId], references: [id], onDelete: Restrict)
  verification WorkVerification?

  @@index([assignmentId, createdAt])
  @@map("completion_submissions")
}

/// The organization's check of one completion submission, by someone other than the worker.
/// Append-only.
model WorkVerification {
  id           String              @id @default(uuid(7)) @db.Uuid
  reportId     String              @map("report_id") @db.Uuid
  assignmentId String              @map("assignment_id") @db.Uuid
  submissionId String              @unique @map("submission_id") @db.Uuid
  verifierId   String              @map("verifier_id") @db.Uuid
  outcome      VerificationOutcome
  reason       String?             @db.VarChar(1000)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  report     Report               @relation(fields: [reportId], references: [id], onDelete: Restrict)
  assignment ReportAssignment     @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  submission CompletionSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  verifier   User                 @relation("WorkVerifier", fields: [verifierId], references: [id], onDelete: Restrict)

  @@index([reportId, createdAt])
  @@map("work_verifications")
}

/// "Is it fixed?" from the reporting citizen after resolution. Feedback only: it never
/// changes the report's status. Append-only.
model CitizenFeedback {
  id        String   @id @default(uuid(7)) @db.Uuid
  reportId  String   @map("report_id") @db.Uuid
  citizenId String   @map("citizen_id") @db.Uuid
  fixed     Boolean
  comment   String?  @db.VarChar(1000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  report  Report @relation(fields: [reportId], references: [id], onDelete: Restrict)
  citizen User   @relation("FeedbackCitizen", fields: [citizenId], references: [id], onDelete: Restrict)

  @@index([reportId, createdAt])
  @@map("citizen_feedback")
}
