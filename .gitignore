# Dependencies
node_modules/

# ML datasets, processed images and pretrained weights (recreated by ml/scripts)
ml/data

# Build output
dist/
coverage/
*.tsbuildinfo

# Environment files (keep the example)
.env
.env.*
!.env.example

# Generated Prisma client (regenerated by `npm install`)
src/generated/

# Python (AI services)
__pycache__/
*.py[cod]
.venv/

# ML: datasets and pretrained downloads stay local (ml/scripts/download_datasets.sh recreates
# them). The released models in ml/models are committed, with checksums in manifest.json.
ml/**/data/
ml/**/*.pt
ml/**/*.onnx
!ml/models/*.pt
.pytest_cache/

# OS / editors
.DS_Store
.idea/
.vscode/*
*.log
