# Dependencies: node_modules links to .deps.nosync/node_modules, which iCloud does not sync
node_modules
*.nosync
ml/data

# Build output
dist/
coverage/
*.tsbuildinfo

# Environment files (keep the example)
.env
.env.*
!.env.example

# Generated Prisma client (regenerated by `npm install`)
src/generated/

# Python (AI services)
__pycache__/
*.py[cod]
.venv/

# ML artifacts are versioned with DVC, never committed directly
ml/**/data/
ml/**/*.pt
ml/**/*.onnx

# OS / editors
.DS_Store
.idea/
.vscode/*
*.log
