# CivicEye backend environment (civiceye_server_side/.env)
# Copy to .env for local development. Never commit real credentials.
# Every variable is validated at startup; the API refuses to start if any is invalid.
# Values below are safe local-development placeholders matching docker-compose.yml.

# development | test | staging | production
NODE_ENV=development
# Port the API listens on.
PORT=4000
# Public URL of the frontend. Its origin is the only CORS origin allowed by default.
WEB_URL=http://localhost:3000
# Optional extra CORS origins, comma-separated (e.g. a staging preview URL). Leave empty normally.
CORS_EXTRA_ORIGINS=
# Set to true only when running behind a trusted reverse proxy / load balancer.
TRUST_PROXY=false

# PostgreSQL with PostGIS. Local value matches docker-compose.yml.
DATABASE_URL=postgresql://civiceye:civiceye_dev_password@localhost:5432/civiceye?schema=public
# Redis (rate limiting now; sessions, queues and realtime in later phases).
REDIS_URL=redis://localhost:6379

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Serve Swagger UI at /api/docs. Defaults to true outside production, false in production.
OPENAPI_ENABLED=

# Global per-client rate limit: at most RATE_LIMIT_MAX_REQUESTS per RATE_LIMIT_WINDOW_SECONDS.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=300

# Timeout for each dependency check in /api/v1/health/ready, in milliseconds.
HEALTH_CHECK_TIMEOUT_MS=2000

# Session cookies are HTTPS-only (Secure). Defaults to true in staging/production, false otherwise.
SESSION_COOKIE_SECURE=
# Encrypts two-factor (TOTP) secrets at rest: 32 random bytes, base64-encoded.
# Generate your own for every environment:  openssl rand -base64 32
# The value below is a PUBLIC placeholder for local development only. Never use it elsewhere.
MFA_ENCRYPTION_KEY=ZGV2LW9ubHktcGxhY2Vob2xkZXIta2V5LTMyYnl0ZXM=

# Email delivery: smtp (local development with Mailpit) or resend (staging/production).
EMAIL_PROVIDER=smtp
EMAIL_FROM="CivicEye <no-reply@civiceye.localhost>"
# Mailpit from docker-compose.yml. View caught mail at http://localhost:8025
SMTP_URL=smtp://127.0.0.1:1025
# Required when EMAIL_PROVIDER=resend. Create one in the Resend dashboard; never commit it.
RESEND_API_KEY=

# Object storage (S3-compatible). Local values match the SeaweedFS service in docker-compose.yml
# and docker/seaweedfs/s3.json (local-development placeholders). For Cloudflare R2 use
# https://<account-id>.r2.cloudflarestorage.com, region auto, and an R2 API token's keys.
STORAGE_ENDPOINT=http://127.0.0.1:8333
STORAGE_REGION=auto
STORAGE_BUCKET=civiceye-media
STORAGE_ACCESS_KEY_ID=civiceye-dev-access
STORAGE_SECRET_ACCESS_KEY=civiceye-dev-secret-not-for-production
# true for SeaweedFS; false for R2.
STORAGE_FORCE_PATH_STYLE=true
# Create the bucket at startup (local development and tests only; rejected in staging/production).
STORAGE_CREATE_BUCKET=true

# Run background job processors in this process. Leave false for the API; the worker
# (npm run worker / node dist/worker.js) enables it.
RUN_WORKERS=false
